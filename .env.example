# ============================================================
# CMND Analytics — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Node ---
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=vr_learning
DB_PASSWORD=password
DB_NAME=vr_learning_db
DB_POOL_MAX=20

# --- JWT ---
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend ---
PORT=5000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5000
VITE_ENV=development

# --- Email (optional, untuk notifikasi) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cimb.local
